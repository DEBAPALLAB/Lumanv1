# This file will be committed to version control, so make sure not to have any
# secrets in it. If you are cloning this repo, create a copy of this file named
# ".env.local" and populate it with your secrets.
#
# ------------------------------------------------------------------------
# Where each of these belongs
# ------------------------------------------------------------------------
# Values marked [SERVER ONLY] must exist on Vercel and in your local
# .env.local, and must NEVER be placed on a user's machine. The desktop app
# does not need them: routes that require one forward the request to your
# deployed backend, carrying the signed-in user's own access token
# (lib/server/delegate.ts). electron/main.js refuses to pass them to an
# installed build at all.
#
# Values marked [PUBLISHABLE] are safe in a distributed installer. The
# Supabase anon key is a client-side value by design — what it can reach is
# decided by Row Level Security, not by keeping the key secret.
# ------------------------------------------------------------------------

# =====================================
# REQUIRED: Supabase Configuration
# =====================================
# Get your Supabase credentials from: https://supabase.com/dashboard/project/_/settings/api
# [PUBLISHABLE]
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
# [SERVER ONLY] Bypasses every RLS rule — reads, edits and deletes any row in
# any table. Used by exactly one function (lib/supabase/admin.ts:getUserById),
# for the members list, because Supabase hides user emails from normal queries.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# =====================================
# REQUIRED: OpenRouter API (for Chat)
# =====================================
# Get your OpenRouter API key here: https://openrouter.ai/keys
# [SERVER ONLY] Billable.
OPENROUTER_API_KEY=your_openrouter_api_key

# =====================================
# OPTIONAL: OpenAI API (for Generate)
# =====================================
# Get your OpenAI API key here: https://platform.openai.com/account/api-keys
# [SERVER ONLY] Billable.
OPENAI_API_KEY=

# =====================================
# OPTIONAL: Groq API (for voice transcription)
# =====================================
# Transcribes recorded voice commands for the voice agent. MediaRecorder +
# this key is the only voice input path (see app/api/voice/transcribe/route.ts
# for why — Chrome's SpeechRecognition is not a real web standard and fails
# unpredictably across browsers and even across Chrome installs). Without this
# key, the voice agent cannot hear you at all.
# Get your key here: https://console.groq.com/keys
# [SERVER ONLY] Billable, but priced far below other Whisper providers.
GROQ_API_KEY=

# =====================================
# OPTIONAL: ElevenLabs API (for voice replies)
# =====================================
# Renders the voice agent's spoken replies (app/api/voice/speak/route.ts).
# Without this key, replies fall back to the browser's built-in
# speechSynthesis, which sounds flat and varies machine to machine.
# Get your key here: https://elevenlabs.io/app/settings/api-keys
#
# ELEVENLABS_VOICE_ID is the default/catch-all voice; falls back to "Sarah",
# a mature/reassuring premade voice (reachable on the free API tier, unlike
# shared library voices such as "Aria"). ELEVENLABS_VOICE_ID_EN / _HI / _MR
# optionally override it per detected spoken language (English, Hindi,
# Marathi) — Whisper detects the language you spoke the command in, and the
# reply is voiced to match rather than always defaulting to English.
# [SERVER ONLY] Billable.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_VOICE_ID_EN=
ELEVENLABS_VOICE_ID_HI=
ELEVENLABS_VOICE_ID_MR=

# =====================================
# REQUIRED: Site Configuration
# =====================================
# Your deployed public origin. Three things depend on it: the desktop OAuth
# handoff, /api/config, and request delegation from the desktop app.
#
# SITE_URL is a real runtime lookup, so the Electron app can override it at
# launch and one binary can target staging or production. NEXT_PUBLIC_SITE_URL
# is inlined by the bundler at build time and only acts as a fallback.
# Set BOTH in Vercel. No trailing slash.
# [PUBLISHABLE]
SITE_URL=https://your-app.vercel.app
NEXT_PUBLIC_SITE_URL=https://your-app.vercel.app

# =====================================
# OPTIONAL: Vercel Blob (for Image Uploads)
# =====================================
# Get your Vercel Blob credentials here: https://vercel.com/docs/storage/vercel-blob/quickstart#quickstart
# [SERVER ONLY] Grants write access to your blob storage.
BLOB_READ_WRITE_TOKEN=

# =====================================
# OPTIONAL: Vercel KV (for Rate Limiting)
# =====================================
# Get your Vercel KV credentials here: https://vercel.com/docs/storage/vercel-kv/quickstart#quickstart
# [SERVER ONLY]
KV_REST_API_URL=
KV_REST_API_TOKEN=

# =====================================
# OPTIONAL: Publishing desktop releases
# =====================================
# Only needed when running `pnpm release`, and only in your own shell — never
# in a build that ships. electron-builder uses it to upload the installer and
# latest.yml to GitHub Releases, which is what installed apps check for updates.
# Create at https://github.com/settings/tokens with `repo` scope.
GH_TOKEN=
