{
  "name": "lumanv1",
  "version": "0.1.0",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "biome lint .",
    "format": "biome format . ",
    "typecheck": "tsc --noEmit",
    "electron": "electron .",
    "electron:prepare": "node scripts/prepare-standalone.js",
    "electron:dir": "next build && node scripts/prepare-standalone.js && electron-builder --win --dir",
    "build:electron": "next build && node scripts/prepare-standalone.js && electron-builder --win",
    "release": "next build && node scripts/prepare-standalone.js && electron-builder --win --publish always"
  },
  "build": {
    "appId": "com.luman.desktop",
    "productName": "Luman",
    "copyright": "Copyright © 2026 Luman",
    "directories": {
      "output": "dist"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "DEBAPALLAB",
        "repo": "Lumanv1",
        "releaseType": "release"
      }
    ],
    "files": [
      "electron/**/*",
      ".next/standalone/**/*",
      "public/**/*",
      "!**/node_modules/.cache/**",
      "!**/*.map",
      "!test-results/**",
      "!e2e/**"
    ],
    "asar": true,
    "asarUnpack": [
      ".next/standalone/**/*"
    ],
    "protocols": [
      {
        "name": "Luman",
        "schemes": [
          "luman"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "public/icon.ico",
      "legalTrademarks": "Luman Desktop Editor"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Luman",
      "installerIcon": "public/icon.ico",
      "uninstallerIcon": "public/icon.ico",
      "artifactName": "Luman Setup ${version}.${ext}"
    },
    "portable": {
      "artifactName": "Luman ${version} Portable.${ext}"
    }
  },
  "dependencies": {
    "@ai-sdk/openai": "^1.1.0",
    "@radix-ui/react-dialog": "^1.0.5",
    "@radix-ui/react-popover": "^1.0.7",
    "@radix-ui/react-scroll-area": "^1.0.5",
    "@radix-ui/react-select": "^2.0.0",
    "@radix-ui/react-separator": "^1.0.3",
    "@radix-ui/react-slot": "^1.1.1",
    "@supabase/ssr": "^0.8.0",
    "@supabase/supabase-js": "^2.89.0",
    "@tailwindcss/typography": "^0.5.10",
    "@tiptap/core": "^2.11.2",
    "@tiptap/extension-character-count": "^2.11.2",
    "@tiptap/extension-code-block-lowlight": "^2.11.2",
    "@tiptap/extension-color": "^2.11.2",
    "@tiptap/extension-highlight": "^2.11.2",
    "@tiptap/extension-horizontal-rule": "^2.11.2",
    "@tiptap/extension-image": "^2.11.2",
    "@tiptap/extension-link": "^2.11.2",
    "@tiptap/extension-placeholder": "^2.11.2",
    "@tiptap/extension-table": "^3.19.0",
    "@tiptap/extension-table-cell": "^3.19.0",
    "@tiptap/extension-table-header": "^3.19.0",
    "@tiptap/extension-table-row": "^3.19.0",
    "@tiptap/extension-task-item": "^2.11.2",
    "@tiptap/extension-task-list": "^2.11.2",
    "@tiptap/extension-text-style": "^2.11.2",
    "@tiptap/extension-underline": "^2.11.2",
    "@tiptap/extension-youtube": "^2.11.2",
    "@tiptap/pm": "^2.11.2",
    "@tiptap/react": "^2.11.2",
    "@tiptap/starter-kit": "^2.11.2",
    "@tiptap/suggestion": "^2.11.2",
    "@upstash/ratelimit": "^1.0.1",
    "@vercel/analytics": "^1.2.2",
    "@vercel/blob": "^0.22.1",
    "@vercel/kv": "^1.0.1",
    "@vercel/speed-insights": "^1.3.1",
    "ai": "^3.0.12",
    "autoprefixer": "^10.4.17",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.0",
    "cmdk": "^1.0.4",
    "date-fns": "^4.1.0",
    "electron-log": "^5.4.4",
    "electron-updater": "^6.8.9",
    "eventsource-parser": "^1.1.2",
    "geist": "^1.5.1",
    "highlight.js": "^11.9.0",
    "jotai": "^2.11.0",
    "katex": "^0.16.11",
    "lowlight": "^3.1.0",
    "lucide-react": "^0.474.0",
    "next": "16.1.6",
    "next-themes": "^0.2.1",
    "openai": "^4.28.4",
    "react": "18.2.0",
    "react-day-picker": "^9.13.0",
    "react-dom": "18.2.0",
    "react-markdown": "^9.0.3",
    "react-moveable": "^0.56.0",
    "react-tweet": "^3.2.1",
    "sonner": "^1.4.3",
    "tailwind-merge": "^2.2.1",
    "tailwindcss-animate": "^1.0.7",
    "tippy.js": "^6.3.7",
    "tiptap-extension-global-drag-handle": "^0.1.16",
    "tiptap-markdown": "^0.8.10",
    "ts-pattern": "^5.0.8",
    "tunnel-rat": "^0.1.2",
    "typescript": "^5.4.2",
    "use-debounce": "^10.0.0",
    "uuid": "^10.0.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.7.2",
    "@playwright/test": "^1.58.1",
    "@types/katex": "^0.16.7",
    "@types/node": "20.11.24",
    "@types/react": "^18.2.61",
    "@types/react-dom": "18.2.19",
    "@types/uuid": "^10.0.0",
    "electron": "^33.4.11",
    "electron-builder": "^26.15.3",
    "postcss-import": "^16.2.0",
    "tailwindcss": "^3.4.1"
  },
  "pnpm": {
    "overrides": {
      "@ai-sdk/provider": "1.0.4"
    }
  }
}
